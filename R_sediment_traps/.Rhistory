library(here)
source(here("init_files", "init.R")) #for libraries
source(here("init_files", "init_markdown.R")) #for markdown libraries
source(here("init_files", "define_functions.R")) #functions to 1.transform to dataframe, 2.normalise and 3.create treemaps
# source(here("init_files", "colours_random.R")) # for colours, using Rcolourbrewer
# cbp1 <- c("#999999", "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7") #another colour-blind palette, if the previous palatte has colours that are too close together.
set.seed(1)
# convert the sample_data() within a phyloseq object to a vegan compatible data object
pssd2veg <- function(physeq) {
sd <- sample_data(physeq)
return(as(sd,"data.frame"))
}
# convert the otu_table() within a phyloseq object to a vegan compatible data object
psotu2veg <- function(physeq) {
OTU <- otu_table(physeq)
if (taxa_are_rows(OTU)) {
OTU <- t(OTU)
}
return(as(OTU, "matrix"))
}
source(here("init_files", "read_data_v3.R")) #load phyloseq and modify variables
ps_all
source(here("init_files", "filt_samples.R")) #filter out replicates, blanks, low read ASVs etc.
ps
sample <- data.frame(ps@sam_data) %>%
rownames_to_column(var = "label")
otu <- psotu2veg(ps)
#sample list of filt samples
sample_list <- sample %>%
select(sample_name)
# subset removed groups and samples from the plot
otu_sub <- otu %>%
as.data.frame()
otu_sub$sample_name <-rownames(otu_sub)
otu_sub <- otu_sub %>%
inner_join(., sample_list)
rownames(otu_sub) <- otu_sub$sample_name
otu_sub <- otu_sub %>%
select(-sample_name) %>%
as.matrix()
library(here)
source(here("init_files", "init.R")) #for libraries
source(here("init_files", "init_markdown.R")) #for markdown libraries
source(here("init_files", "define_functions.R")) #functions to 1.transform to dataframe, 2.normalise and 3.create treemaps
# source(here("init_files", "colours_random.R")) # for colours, using Rcolourbrewer
# cbp1 <- c("#999999", "#E69F00", "#56B4E9", "#009E73", "#F0E442", "#0072B2", "#D55E00", "#CC79A7") #another colour-blind palette, if the previous palatte has colours that are too close together.
set.seed(1)
# convert the sample_data() within a phyloseq object to a vegan compatible data object
pssd2veg <- function(physeq) {
sd <- sample_data(physeq)
return(as(sd,"data.frame"))
}
# convert the otu_table() within a phyloseq object to a vegan compatible data object
psotu2veg <- function(physeq) {
OTU <- otu_table(physeq)
if (taxa_are_rows(OTU)) {
OTU <- t(OTU)
}
return(as(OTU, "matrix"))
}
source(here("init_files", "read_data_v3.R")) #load phyloseq and modify variables
ps_all
source(here("init_files", "filt_samples.R")) #filter out replicates, blanks, low read ASVs etc.
ps
sample <- data.frame(ps@sam_data) %>%
rownames_to_column(var = "label")
otu <- psotu2veg(ps)
#sample list of filt samples
sample_list <- sample %>%
select(sample_name)
# subset removed groups and samples from the plot
otu_sub <- otu %>%
as.data.frame()
otu_sub$sample_name <-rownames(otu_sub)
otu_sub <- otu_sub %>%
inner_join(., sample_list)
rownames(otu_sub) <- otu_sub$sample_name
otu_sub <- otu_sub %>%
select(-sample_name) %>%
as.matrix()
dist <- avgdist(otu_sub, sample = 1066, dmethod = "bray") #rarify to control for uneven number of reads per sample. lowest number of reads in a sample is 1066.
nmds_sub<- metaMDS(dist)
nmds_sample_sub <- scores(nmds_sub) %>%
as.tibble(rownames="sample_name") %>%
inner_join(., sample, by = "sample_name")
goodness(nmds_sub)
stressplot(nmds_sub)
nmds_sub$stress
#plot by sample type
nmds_sample <- nmds_sample_sub %>%
mutate(cycle_name_2 = fct_relevel(cycle_name_2, "ST1", "ST2", "SA-Sc", "SA1","SA2" )) %>%
mutate(sample = fct_relevel(sample, "water_CTD", "water_pump", "trap_fix", "trap_live", "core")) %>%
ggplot() +
stat_ellipse(aes(x=NMDS1, y= NMDS2, colour = sample)) +
geom_point(aes(x=NMDS1, y= NMDS2, colour = sample, shape = cycle_name_2
)) +
scale_colour_manual(values = sample_palette) +
scale_shape_manual(values=c(3,7,16,17,15)) + # shapes for cycle
theme(legend.position = "right") +
annotate("text", x = 0.3, y = -0.5, label = "Stress = 0.20")
nmds_sample
# pdf("nmds_samples.pdf", height=5, width=6) ; plot(nmds_sample) ; dev.off()
#plot by sample type
nmds_sample <- nmds_sample_sub %>%
mutate(cycle_name_2 = fct_relevel(cycle_name_2, "ST1", "ST2", "SA-Sc", "SA1","SA2" )) %>%
mutate(sample = fct_relevel(sample, "water_CTD", "water_pump", "trap_fix", "trap_live", "core")) %>%
ggplot() +
stat_ellipse(aes(x=NMDS1, y= NMDS2, colour = sample)) +
geom_point(aes(x=NMDS1, y= NMDS2, colour = sample, shape = cycle_name_2
), size =3) +
scale_colour_manual(values = sample_palette) +
scale_shape_manual(values=c(3,7,16,17,15)) + # shapes for cycle
theme(legend.position = "right") +
annotate("text", x = 0.3, y = -0.5, label = "Stress = 0.20")
nmds_sample
#plot by sample type
nmds_sample <- nmds_sample_sub %>%
mutate(cycle_name_2 = fct_relevel(cycle_name_2, "ST1", "ST2", "SA-Sc", "SA1","SA2" )) %>%
mutate(sample = fct_relevel(sample, "water_CTD", "water_pump", "trap_fix", "trap_live", "core")) %>%
ggplot() +
stat_ellipse(aes(x=NMDS1, y= NMDS2, colour = sample)) +
geom_point(aes(x=NMDS1, y= NMDS2, colour = sample, shape = cycle_name_2
), size =2.5) +
scale_colour_manual(values = sample_palette) +
scale_shape_manual(values=c(3,7,16,17,15)) + # shapes for cycle
theme(legend.position = "right") +
annotate("text", x = 0.3, y = -0.5, label = "Stress = 0.20")
nmds_sample
