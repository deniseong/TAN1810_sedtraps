source(here("init_files", "filt_samples.R")) #filter out replicates, blanks, low read ASVs etc.
ps
sample <- data.frame(ps@sam_data) %>%
rownames_to_column(var = "label")
otu <- psotu2veg(ps)
#sample list of filt samples
sample_list <- sample %>%
select(sample_name)
# subset removed groups and samples from the plot
otu_sub <- otu %>%
as.data.frame()
otu_sub$sample_name <-rownames(otu_sub)
otu_sub <- otu_sub %>%
inner_join(., sample_list)
rownames(otu_sub) <- otu_sub$sample_name
otu_sub <- otu_sub %>%
select(-sample_name) %>%
as.matrix()
View(sample)
View(sample)
ps <- ps %>%
ps_filter(sample == "core")
ps
sample <- data.frame(ps@sam_data) %>%
rownames_to_column(var = "label")
otu <- psotu2veg(ps)
#sample list of filt samples
sample_list <- sample %>%
select(sample_name)
# subset removed groups and samples from the plot
otu_sub <- otu %>%
as.data.frame()
otu_sub$sample_name <-rownames(otu_sub)
otu_sub <- otu_sub %>%
inner_join(., sample_list)
rownames(otu_sub) <- otu_sub$sample_name
otu_sub <- otu_sub %>%
select(-sample_name) %>%
as.matrix()
p <- rarecurve(otu_sub, step = 40, label = FALSE)
