theme(
axis.text.x = element_text(angle = 45, hjust = 1),  # rotate x-axis labels
legend.text = element_text(size = 12),
legend.title = element_text(size = 14),
legend.key.size = unit(1.5, "lines"))  # size of legend boxes
p
