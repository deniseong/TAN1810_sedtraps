group_var <- "sample_depth"
# 1. Pull metadata as an explicit standard R data frame
metadata_df <- data.frame(sample_data(deseq.st))
# 2. Extract unique sample depth groups
group_names <- unique(metadata_df[[group_var]])
# 3. Safely map across groups using pure R matrix rules
taxa_by_group <- group_names %>%
map(function(x) {
# Isolate sample IDs belonging to the active depth group
target_samples <- rownames(metadata_df[metadata_df[[group_var]] == x, ])
# Extract the OTU table cleanly as a plain data matrix
otu_matrix <- as(otu_table(deseq.st), "matrix")
# Slice the matrix based on your orientation
if (taxa_are_rows(deseq.st)) {
sub_otu <- otu_matrix[, target_samples, drop = FALSE]
keep_taxa <- rowSums(sub_otu) > 0
} else {
sub_otu <- otu_matrix[target_samples, , drop = FALSE]
keep_taxa <- colSums(sub_otu) > 0
}
# Return the clean character vector of active ASV names
return(names(keep_taxa)[keep_taxa])
}) %>%
set_names(group_names) # Explicitly name your list items by depth
