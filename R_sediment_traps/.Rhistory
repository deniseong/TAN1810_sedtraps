sigtab_export_sub_SA %>%
ggplot(aes(x=log2FoldChange, y=-(log10(padj))))+
geom_point()
sigtab_export_taxa <- sigtab_export_sub_SA %>%
### select only few taxa to plot at order level. Rest at class or family (Diatoms) level
mutate(taxa = case_when(subdivision == "Dinoflagellata" ~ as.character(order),
# class == "Polycystinea" ~ as.character(order),
# class == "Acantharea" ~ as.character(order),
# class == "Prymnesiophyceae" ~ as.character(order),
# subdivision == "Gyrista" ~ as.character(order),
TRUE~ as.character(class)))
sigtab_transfer_taxa$taxa <- as.character(sigtab_transfer_taxa$taxa)
sigtab_export_taxa <- full_join(sigtab_export_taxa, core_asvs_SA) %>%
mutate(sediment = coalesce(sediment, "not detected")) %>%
filter(!(is.na(log2FoldChange)))
sigtab_export_taxa <- sigtab_export_taxa %>%
arrange(taxa)
```{r}
sigtab_transfer <- sigtab_transfer_sub_SA %>%
dplyr::rename("baseMean_trans" = "baseMean",
"log2FoldChange_trans" = "log2FoldChange",
"lfcSE_trans" = "lfcSE",
"stat_trans" = "stat",
"pvalue_trans" = "pvalue",
"padj_trans" = "padj")
sigtab_export <- sigtab_export_sub_SA %>%
dplyr::rename("baseMean_exp" = "baseMean",
"log2FoldChange_exp" = "log2FoldChange",
"lfcSE_exp" = "lfcSE",
"stat_exp" = "stat",
"pvalue_exp" = "pvalue",
"padj_exp" = "padj")
sigtab_export_transfer_SA <- full_join(sigtab_transfer, sigtab_export) %>%
drop_na() %>%
full_join(core_asvs_SA) %>%
mutate(sediment = coalesce(sediment, "not detected")) %>% # label sediment ASVs
filter(!(is.na(log2FoldChange_trans)))%>%
### select only few taxa to plot at order level. Rest at class or family (Diatoms) level
mutate(taxa = case_when(subdivision == "Dinoflagellata" ~ as.character(order),
# class == "Polycystinea" ~ as.character(order),
# class == "Acantharea" ~ as.character(order),
# class == "Prymnesiophyceae" ~ as.character(order),
# subdivision == "Gyrista" ~ as.character(order),
TRUE~ as.character(class)))
# writexl::write_xlsx(sigtab_export_transfer_SA, path = "deseq_sigtab_export_transfer_SA.xlsx")
sigtab_export_transfer_SA_sub <- sigtab_export_transfer_SA %>%
filter(subdivision != "Dinoflagellata")
g6 <- sigtab_export_transfer_SA_sub %>%
ggplot(aes(x = log2FoldChange_exp, y = log2FoldChange_trans, label=class)) +
geom_point(aes(shape=sediment, size=sediment, fill = subdivision), colour = "black")+
geom_text_repel(
data = subset(sigtab_export_transfer_SA_sub, sediment == "detected"),
aes(label = taxa, colour = subdivision),
size = 3.5, max.overlaps = 30,
box.padding = 0.5,
point.padding = 0,
hjust = "outward",
direction = "y"
# min.segment.length = 0.25
# size=2, max.overlaps = 10
)+
geom_vline(xintercept = 0, linetype="solid") +
geom_hline(yintercept = 0, linetype="solid") +
# ggtitle("Export vs transfer efficiency") +
xlab("Export efficiency log2 fold change - Water CTD <--> Upper fixed traps") +
ylab("Transfer efficiency log2 fold change - Upper <--> Lower fixed traps") +
scale_colour_manual(values=divisionPalette)+
scale_fill_manual(values=divisionPalette)+
theme(axis.text.x = element_text(size = 10),
axis.title.x =element_text(size=10),
axis.text.y = element_text(size = 10),
legend.title = element_text(size = 10),
legend.text = element_text(size = 10),
legend.position = "right") +
coord_fixed() +
ggtitle("Subantarctic")+
scale_size_manual(values=c(2.5,2)) +
scale_shape_manual(values = c(24,21)) +
scale_y_continuous(limits = c(-10, 10))+
scale_x_continuous(limits = c(-10, 10))
g6
