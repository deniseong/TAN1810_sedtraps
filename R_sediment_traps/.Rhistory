size = 3, max.overlaps = 30,
box.padding = 0.5,
point.padding = 0,
hjust = "outward",
direction = "y"
# min.segment.length = 0.25
# size=2, max.overlaps = 10
)+
geom_vline(xintercept = 0, linetype="solid") +
geom_hline(yintercept = 0, linetype="solid") +
# ggtitle("Export vs transfer efficiency") +
xlab("Export efficiency log2 fold change - Water CTD <--> Upper fixed traps") +
ylab("Transfer efficiency log2 fold change - Upper <--> Lower fixed traps") +
scale_colour_manual(values=divisionPalette)+
scale_fill_manual(values=divisionPalette)+
theme(axis.text.x = element_text(size = 9),
axis.title.x =element_text(size=10),
axis.text.y = element_text(size = 9),
legend.title = element_text(size = 10),
legend.text = element_text(size = 10),
legend.position = "right") +
coord_fixed() +
ggtitle("Subantarctic")+
scale_size_manual(values=c(2.5,2)) +
scale_shape_manual(values = c(24,21)) +
scale_y_continuous(limits = c(-10, 10))+
scale_x_continuous(limits = c(-10, 10))
